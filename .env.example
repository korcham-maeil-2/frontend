# 월급지도 프론트 환경 변수 예시
#
# 로컬 개발: 이 파일을 .env.local로 복사해서 쓴다.
# 서버 배포: 서버의 프론트 배포 폴더에 .env로 둔다 (docker compose가 읽어서 빌드할 때 넘긴다).
#
# NEXT_PUBLIC_로 시작하는 값은 "빌드할 때" 화면 코드에 들어가고 브라우저에 공개된다.
# 값을 바꾸면 다시 빌드해야 한다 (docker compose up -d --build).
# 비밀 값(API 키 등)은 여기에 넣지 않는다.

# 백엔드 주소. 비우면 http://localhost:8000 (Docker 빌드 기본값은 배포 백엔드)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 공유 배포 백엔드를 쓰려면:
# NEXT_PUBLIC_API_BASE_URL=https://maeil2-backend.sunghoyaaa.com

# 화면 오류 추적 (GlitchTip 조직 maeil2 / 프로젝트 maeil2-frontend의 DSN).
# 비우면 오류 추적을 끈다 (로컬 개발·CI는 비워 둔다). Sentry 형식 DSN은 보내기 전용이라 공개돼도 된다.
NEXT_PUBLIC_SENTRY_DSN=

# 어느 환경의 오류인지. 비우면 production (로컬에서 시험할 때 development).
# Docker 빌드에는 넘기지 않는다 (배포는 늘 production)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# 어느 배포의 오류인지. 배포 작업(deploy.yml)이 frontend@커밋번호로 넘기므로 보통 비워 둔다.
# NEXT_PUBLIC_SENTRY_RELEASE=
